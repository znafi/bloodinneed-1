{
  "name": "bloodinneed",
  "version": "1.0.0",
  "private": true,
  "description": "Blood Donation Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "client-install": "npm ci --prefix client",
    "client-build": "BUILD_PATH=../public npm run build --prefix client",
    "build": "npm run client-install && npm run client-build",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongoose": "^7.6.3",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
