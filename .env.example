# Copy to .env for local development and fill in real values. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Required. MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bloodinneed?retryWrites=true&w=majority

# Local only. Vercel does not use a port listener.
PORT=10000

# "development" or "production". Vercel sets this to "production" automatically.
NODE_ENV=development

# Optional. Comma separated list of allowed cross-origin callers.
# Leave unset when the API is only used by the bundled React client.
CORS_ORIGINS=
